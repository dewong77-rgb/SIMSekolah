{
  "redirects": [
    {
      "source": "/staff",
      "destination": "/struktur-organisasi",
      "permanent": false
    },
    {
      "source": "/berita/profil",
      "destination": "/profil",
      "permanent": false
    },
    {
      "source": "/berita/profil/:slug",
      "destination": "/jurusan",
      "permanent": false
    },
    {
      "source": "/berita/kategori/:slug",
      "destination": "/berita",
      "permanent": false
    },
    {
      "source": "/berita/read/:slug",
      "destination": "/berita",
      "permanent": false
    },
    {
      "source": "/prestasi/:path+",
      "destination": "/prestasi",
      "permanent": false
    },
    {
      "source": "/galeri",
      "destination": "/berita",
      "permanent": false
    },
    {
      "source": "/video",
      "destination": "/berita",
      "permanent": false
    },
    {
      "source": "/portfolio",
      "destination": "/berita",
      "permanent": false
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/berita",
      "permanent": false
    },
    {
      "source": "/ekstrakurikuler/:path+",
      "destination": "/ekstrakurikuler",
      "permanent": false
    },
    {
      "source": "/fasilitas",
      "destination": "/profil",
      "permanent": false
    },
    {
      "source": "/fasilitas/:path*",
      "destination": "/profil",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/download/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/layanan",
      "destination": "/masuk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
